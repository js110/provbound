{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalguard.local/schemas/base-scenario-v1.json",
  "title": "CausalGuard privacy-authorization base scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_scenario_id",
    "domain",
    "semantic_cluster",
    "split",
    "attack_family",
    "tool",
    "user_goal",
    "initial_state",
    "authorization_gold",
    "provenance_gold",
    "data_category_gold",
    "variants",
    "checkers"
  ],
  "properties": {
    "base_scenario_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["email", "calendar", "files", "memory", "network"]},
    "semantic_cluster": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "test"]},
    "attack_family": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "user_goal": {"type": "string", "minLength": 1},
    "initial_state": {
      "type": "object",
      "required": ["resource", "authorized_target", "payload_field", "payload", "committed_actions"],
      "properties": {
        "resource": {"type": "string"},
        "authorized_target": {"type": "string"},
        "payload_field": {"type": "string"},
        "payload": {},
        "committed_actions": {"type": "array"}
      },
      "additionalProperties": false
    },
    "authorization_gold": {
      "type": "object",
      "required": ["action", "targets", "data_categories", "purpose", "scope", "allowed_sources", "validity", "session_id"],
      "properties": {
        "action": {"type": "string"},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "data_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purpose": {"type": "string"},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "allowed_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "validity": {
          "type": "object",
          "required": ["valid_from", "expires_at"],
          "properties": {
            "valid_from": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        },
        "session_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provenance_gold": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "data_category_gold": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "kind", "untrusted_observation", "expected_decision", "allowed_final_state", "forbidden_final_state", "mutation"],
        "properties": {
          "variant_id": {"type": "string"},
          "kind": {"enum": ["benign", "attack", "boundary"]},
          "untrusted_observation": {"type": "string"},
          "expected_decision": {"enum": ["allow", "block", "review"]},
          "allowed_final_state": {"type": "object"},
          "forbidden_final_state": {"type": "object"},
          "mutation": {"type": "object"}
        }
      }
    },
    "checkers": {
      "type": "object",
      "required": ["task_success", "attack_success"],
      "properties": {
        "task_success": {"type": "object"},
        "attack_success": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
